// gl_exports.inl
//   X-macro list of every symbol exported by the Windows opengl32.dll (OpenGL 1.1 core,
//   WGL and the legacy GLMF metafile entry points). Anything newer than GL 1.1 is never
//   exported - games fetch it at runtime through wglGetProcAddress, which we forward.
//
//   The includer defines PXY_EXPORT(name) before including this file. proxy.cpp uses it
//   twice: once to emit a jump stub + linker export per name, once to build a name table.

// --- GLMF (metafile playback, kept for completeness) ---
PXY_EXPORT(GlmfBeginGlsBlock)  PXY_EXPORT(GlmfCloseMetaFile)  PXY_EXPORT(GlmfEndGlsBlock)
PXY_EXPORT(GlmfEndPlayback)    PXY_EXPORT(GlmfInitPlayback)   PXY_EXPORT(GlmfPlayGlsRecord)

